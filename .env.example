# StreamGuardian AI — environment configuration.
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Every value below is a placeholder. The app runs in Demo Mode with
# everything below left empty, except in production where SESSION_SECRET
# is required.

# Port the API server listens on (default 4000).
PORT=4000

# Public URL of the client, used for OAuth redirects (default http://localhost:5173).
CLIENT_URL=http://localhost:5173

# Where the local demo database lives (default ./data/streamguardian.sqlite,
# relative to the server working directory).
DATABASE_PATH=./data/streamguardian.sqlite

# Session secret for demo moderator cookies.
# Optional in development (an ephemeral secret is generated with a warning).
# REQUIRED in production (NODE_ENV=production) — the server refuses to start without it.
SESSION_SECRET=change-me-to-a-long-random-string

# Node environment: development | production
NODE_ENV=development

# --- Twitch (optional) ------------------------------------------------------
# Without all three, the app runs in Demo Mode and /api/auth/twitch
# returns HTTP 503 with a clear message. Never put these in the client.
# Create an app at https://dev.twitch.tv/console/apps and set its OAuth
# Redirect URL to exactly TWITCH_REDIRECT_URI below.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/api/auth/twitch/callback

# --- OpenAI (optional) ------------------------------------------------------
# Without a key, classification uses the deterministic rules engine and the
# UI labels every analysis "Deterministic fallback — no AI call made".
# The key is only ever used server-side, with a timeout and a validated
# JSON response. Chat text is sent as data only, never as instructions.
OPENAI_API_KEY=
# Model used when a key is set (default gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
